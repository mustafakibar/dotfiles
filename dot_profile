# ~/.profile — read by bash login shells and by some display managers.
#
# Holds NO PATH logic of its own; everything lives in ~/.config/shell/env.sh,
# which is the single owner. zsh does not read this file; its counterpart
# is ~/.zshenv.

if [ -z "${KB_ENV_LOADED:-}" ]; then
  KB_ENV_LOADED=1
  export KB_ENV_LOADED
  [ -r "$HOME/.config/shell/env.sh" ] && . "$HOME/.config/shell/env.sh"
fi

# Under a login bash, load the interactive configuration too.
if [ -n "${BASH_VERSION:-}" ] && [ -f "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi
