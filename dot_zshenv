# ~/.zshenv — read on EVERY zsh invocation, including scripts and non-login shells.
#
# PATH is set up here rather than in .zprofile: most terminal emulators start
# zsh as a NON-login interactive shell and never read .zprofile.
#
# The sentinel is exported, so subshells inherit PATH and skip this block.
# To reload the environment: reload   (the alias clears the sentinel)

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

if [[ -z $KB_ENV_LOADED ]]; then
  export KB_ENV_LOADED=1
  [[ -r $XDG_CONFIG_HOME/shell/env.sh ]] && source "$XDG_CONFIG_HOME/shell/env.sh"
fi

# Deduplicate PATH and fpath automatically — a second guard behind env.sh.
typeset -U path fpath
