# ~/.zshrc — INTERACTIVE zsh sessions only.
# PATH and environment variables live in .zshenv -> ~/.config/shell/env.sh.

# ─── Warp detection ─────────────────────────────────────────────────────────
# Warp runs its own shell layer and does not work with ZLE widgets; its own
# documentation lists zsh-autosuggestions, fzf and compinit as incompatible:
#   https://docs.warp.dev/support-and-community/troubleshooting-and-support/known-issues/
#
# That applies only to the shell Warp starts DIRECTLY. nvim :terminal, tmux
# and ssh inherit $TERM_PROGRAM but run real ZLE, so everything is enabled
# in those contexts.
if [[ $TERM_PROGRAM == WarpTerminal && -z $NVIM && -z $TMUX && -z $SSH_CONNECTION ]]; then
  KB_WARP_NATIVE=1
else
  KB_WARP_NATIVE=0
fi

# ─── oh-my-zsh ────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                          # the prompt belongs to Starship
DISABLE_MAGIC_FUNCTIONS="true"        # paste and completion speed
zstyle ':omz:update' mode disabled     # current replacement for DISABLE_AUTO_UPDATE

# Move the compinit dump into the XDG cache so it stays out of $HOME.
ZSH_COMPDUMP="$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"
[[ -d $XDG_CACHE_HOME/zsh ]] || mkdir -p "$XDG_CACHE_HOME/zsh"

plugins=(git sudo extract copyfile copybuffer)

if (( ! KB_WARP_NATIVE )); then
  # Order matters: zsh-syntax-highlighting must come LAST.
  plugins+=(zsh-completions zsh-autosuggestions zsh-syntax-highlighting)

  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
  ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20      # no suggestions on long lines (speed)
  ZSH_AUTOSUGGEST_MANUAL_REBIND=1         # skip rebinding on every prompt
fi

# Guarded source, so a fresh $HOME — right after chezmoi init, before
# oh-my-zsh is installed — does not print an error on every shell startup.
if [[ -r $ZSH/oh-my-zsh.sh ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -u2 "zshrc: oh-my-zsh not found at $ZSH — run ~/.local/share/chezmoi/scripts/bootstrap-tools.sh"
fi

# ─── history ───────────────────────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt EXTENDED_HISTORY          # record timestamp and duration
setopt HIST_EXPIRE_DUPS_FIRST    # drop duplicates first when trimming
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE         # do not record commands starting with a space
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_REDUCE_BLANKS        # strip redundant whitespace
setopt HIST_VERIFY               # show history expansion before running it
setopt SHARE_HISTORY             # share instantly between sessions

# ─── shell behaviour ──────────────────────────────────────────────────────
setopt AUTO_CD                   # type 'src' to mean 'cd src'
setopt INTERACTIVE_COMMENTS      # allow # comments on the interactive line
setopt GLOB_DOTS                 # let globs match hidden files
setopt NUMERIC_GLOB_SORT         # file2 < file10
setopt NO_BEEP

# ─── completion ────────────────────────────────────────────────────────────
if (( ! KB_WARP_NATIVE )); then
  zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
  zstyle ':completion:*' menu select
  zstyle ':completion:*' group-name ''
  zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
  zstyle ':completion:*:descriptions' format '%F{yellow}── %d ──%f'
  zstyle ':completion:*' use-cache on
  zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/zcompcache"
fi

# ─── aliases ────────────────────────────────────────────────────────────
[[ -r $XDG_CONFIG_HOME/shell/aliases.sh ]] && source "$XDG_CONFIG_HOME/shell/aliases.sh"

# ─── fnm (Node version manager) ──────────────────────────────────────────
# The PATH entry lives in env.sh; this is only the shell integration.
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# ─── zoxide ───────────────────────────────────────────────────────────────
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
  alias j='z'
fi

# ─── fzf ──────────────────────────────────────────────────────────────────
# ~/.fzf.zsh never existed but was being sourced, so the key bindings were
# never installed. The correct form is fzf's own generated integration.
if (( ! KB_WARP_NATIVE )) && command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)

  export FZF_DEFAULT_COMMAND='fd --type=file --hidden --follow --exclude=.git'
  export FZF_DEFAULT_OPTS='--height=50% --layout=reverse --border=rounded --info=inline'

  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range=:200 {}'"

  export FZF_ALT_C_COMMAND='fd --type=directory --hidden --follow --exclude=.git'
  export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --icons=always --color=always {}'"
fi

# ─── bun ──────────────────────────────────────────────────────────────────
[[ -s $HOME/.bun/_bun ]] && source "$HOME/.bun/_bun"

# ─── prompt (last) ────────────────────────────────────────────────────
# Enabled everywhere, Warp included: Warp has its own support page for
# Starship, and with ZSH_THEME empty, skipping it leaves a bare prompt.
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
