" ~/.vimrc — plugin-free fallback configuration.
"
" On this machine /usr/bin/vim is a symlink to nvim, and the real Neovim
" configuration lives in ~/.config/nvim. This file exists for:
"   - vim.tiny (rescue mode, minimal containers)
"   - remote servers without Neovim
"   - root shells
"
" LAYOUT: layer 1 runs on every vim build. Layer 2 sits entirely inside
" 'if 1 ... endif' and is skipped by builds without +eval, so when adding
" lines to layer 2, keep them INSIDE the block.

" ══════════════════════════════════════════════════════════════════════
" Layer 1 — core, requires no compiled features
" ══════════════════════════════════════════════════════════════════════
set nocompatible

set backspace=indent,eol,start
set number
set ruler
set showcmd
set hidden
set autoindent
set expandtab
set shiftwidth=2
set softtabstop=2
set tabstop=2
set smarttab
set shiftround
set scrolloff=5
set sidescrolloff=8
set laststatus=2
set wildmenu
set ignorecase
set smartcase
set hlsearch
set nobackup
set nowritebackup
set noswapfile
set history=1000
set ttimeout
set ttimeoutlen=50
set splitbelow
set splitright
set title
set autoread
set lazyredraw
set nrformats-=octal

" Built-in finder: :find searches subdirectories, standing in for CtrlP
set path+=**
set wildignore+=*/node_modules/*,*/.git/*,*/dist/*,*/build/*,*/.next/*

" ── keymaps (mapping commands do not need +eval) ─────────────────────
nnoremap <C-q> :q!<CR>
nnoremap <C-s> :w<CR>
nnoremap <F3>  :set hlsearch!<CR>
nnoremap <F4>  :bd<CR>
nnoremap <F5>  :Lexplore<CR>
nnoremap n nzz
nnoremap N Nzz
nnoremap Y y$
nnoremap Q <nop>
nnoremap ; :
nnoremap <Tab>   gt
nnoremap <S-Tab> gT
nnoremap <a-right> gt
nnoremap <a-left>  gT
nnoremap <silent> <S-t> :tabnew<CR>

" Added for consistency with the nvim config; the old .vimrc lacked it.
inoremap jk <Esc>

" keep the selection when indenting in visual mode
vnoremap < <gv
vnoremap > >gv

" place the cursor inside the pair
inoremap <> <><Left>
inoremap () ()<Left>
inoremap {} {}<Left>
inoremap [] []<Left>
inoremap "" ""<Left>
inoremap '' ''<Left>
inoremap `` ``<Left>

" arrow-key replacements in insert mode
inoremap <C-k> <Up>
inoremap <C-j> <Down>
inoremap <C-h> <Left>
inoremap <C-l> <Right>
inoremap <C-u> <Esc>ui

" ══════════════════════════════════════════════════════════════════════
" Layer 2 — everything that needs +eval
" ══════════════════════════════════════════════════════════════════════
if 1
  let mapleader = ','

  filetype plugin indent on

  if has('syntax')
    syntax enable
    set background=dark
    silent! colorscheme habamax
  endif

  if has('extra_search')
    set incsearch
  endif

  if has('termguicolors') && $COLORTERM =~# 'truecolor\|24bit'
    set termguicolors
  endif

  if has('mouse')
    set mouse=a
  endif

  if has('clipboard')
    set clipboard=unnamedplus
    vnoremap <C-p> "+p
  endif

  if has('linebreak')
    set breakindent
    set linebreak
  endif

  if has('multi_byte')
    set encoding=utf-8
    scriptencoding utf-8
    set listchars=tab:→\ ,trail:·,extends:❯,precedes:❮,nbsp:␣
  else
    set listchars=tab:>\ ,trail:.,extends:>,precedes:<
  endif

  " ── persistent undo ────────────────────────────────────────────────
  if has('persistent_undo')
    let s:undodir = expand('~/.local/state/vim/undo')
    if !isdirectory(s:undodir)
      silent! call mkdir(s:undodir, 'p', 0700)
    endif
    if isdirectory(s:undodir)
      let &undodir = s:undodir
      set undofile
    endif
  endif

  " ── statusline (standing in for airline) ───────────────────────────
  if has('statusline')
    set statusline=
    set statusline+=\ %f
    set statusline+=\ %m%r%h%w
    set statusline+=%=
    set statusline+=\ %y
    set statusline+=\ %{&fileencoding!=#''?&fileencoding:&encoding}
    set statusline+=\ [%{&fileformat}]
    set statusline+=\ %l:%c
    set statusline+=\ %3p%%\
  endif

  " ── netrw (NERDTree'nin yerine) ────────────────────────────────────
  let g:netrw_banner = 0
  let g:netrw_liststyle = 3
  let g:netrw_browse_split = 4
  let g:netrw_altv = 1
  let g:netrw_winsize = 25
  let g:netrw_hide = 0

  " ── matchit: % jumps between if/endif and open/close tags ──────────
  if has('packages')
    silent! packadd! matchit
  else
    silent! runtime macros/matchit.vim
  endif

  " ── cursor shape: block in normal mode, bar in insert ──────────────
  let &t_SI = "\e[6 q"
  let &t_SR = "\e[4 q"
  let &t_EI = "\e[2 q"

  " ── italik ─────────────────────────────────────────────────────────
  let &t_ZH = "\e[3m"
  let &t_ZR = "\e[23m"

  " ── leader keymaps ─────────────────────────────────────────────────
  nnoremap <leader>h :nohlsearch<CR>
  nnoremap <leader>w :w<CR>
  nnoremap <leader>q :q<CR>
  nnoremap <leader>l :set list!<CR>
  nnoremap <leader>n :set relativenumber!<CR>

  if has('terminal')
    nnoremap <F6> :sp<CR>:terminal<CR>
  elseif has('nvim')
    nnoremap <F6> :sp<CR>:terminal<CR>
  endif

  " ── autocmd'ler ────────────────────────────────────────────────────
  if has('autocmd')
    augroup vimrc_restore_cursor
      autocmd!
      " reopen the file on the last edited line
      autocmd BufReadPost *
        \ if line("'\"") >= 1 && line("'\"") <= line("$") && &filetype !~# 'commit'
        \ |   execute "normal! g`\""
        \ | endif
    augroup END

    augroup vimrc_misc
      autocmd!
      " leave paste mode when leaving insert
      autocmd InsertLeave * set nopaste
      " open help windows vertically
      autocmd FileType help wincmd L
    augroup END
  endif

  set relativenumber
  set cursorline
endif
